includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # The package's own config/ is not the host app's config path; ArchTest guards src/ instead.
    noEnvCallsOutsideOfConfig: false
    paths:
        - src
        - config
        - database
    ignoreErrors:
        # A trait for other packages' Filament resources to use; nothing in core does.
        -
            message: '#Trait Filagora\\Core\\Filament\\Concerns\\GatedByAbility is used zero times#'
            path: src/Filament/Concerns/GatedByAbility.php
