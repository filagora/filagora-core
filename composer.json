{
    "name": "zencart/forumkit-core",
    "description": "ForumKit core: module registry, settings and shared support for the ForumKit Filament packages.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "filament-plugin", "forum"],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ForumKit\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ForumKit\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ForumKit\\Core\\CoreServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
